# BMG PMS â€” Edge Function secrets (server side only, never in the web app or GitHub)
#
# 1. Copy this file:            cp supabase/secrets.env.example supabase/secrets.env
# 2. Fill in the values below. Leave a line empty (or delete it) for a service you do not use yet.
# 3. Send them to Supabase:     supabase secrets set --env-file supabase/secrets.env --project-ref <your-project-ref>
# 4. Check what is set:         supabase secrets list --project-ref <your-project-ref>
# 5. Delete your copy afterwards, or keep it only in your password manager. .gitignore keeps it out of GitHub.
#
# Do the same for staging with the sandbox values and the staging project ref.
# Supabase already provides SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY to the functions: do not set them.
# Make long random values with:  openssl rand -hex 32

# ---------------------------------------------------------------- always
# Scheduled jobs prove who they are with this. The SAME value goes into supabase/schedules.sql (pms_cron_secret).
CRON_SECRET=64264e8f10eff0bee109bad78321fb160e1d982d64334cf66e290af256ec2df7
# The web address(es) of the app, comma-separated, exactly as in the browser bar: https:// and no slash at the end.
#   e.g. APP_ORIGINS=https://bmg-pms.netlify.app,https://pms.bmggroup.co.tz
APP_ORIGINS=https://bmg-pms.netlify.app

# ---------------------------------------------------------------- SMS (Beem Africa) â€” beem.africa â†’ Profile â†’ Authentication information
BEEM_API_KEY=
BEEM_SECRET_KEY=

# ---------------------------------------------------------------- Email (Resend) â€” resend.com â†’ API keys. Guest portal links and login keys.
# Verify your sending domain in Resend first (Domains â†’ Add, then the DNS records it shows).
RESEND_API_KEY=
# The sender address on that domain. Each hotel's name is shown as the sender; replies go to the hotel's own email.
EMAIL_FROM=BMG Hotels <stay@bmggroup.co.tz>

# ---------------------------------------------------------------- Channex (OTAs) â€” Channex â†’ Profile â†’ API keys
CHANNEX_API_KEY=
# Production. Leave empty while testing: the default is staging.channex.io
CHANNEX_BASE_URL=https://app.channex.io/api/v1
# Random value; it ends the webhook URL you paste into Channex (shown on Integrations â†’ Channex)
CHANNEX_WEBHOOK_TOKEN=

# ---------------------------------------------------------------- TTLock (door codes) â€” open.ttlock.com â†’ your application
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
# The TTLock app account that owns the locks (plain password; it is hashed before sending)
TTLOCK_USERNAME=
TTLOCK_PASSWORD=
# Only if TTLock gave you a different region server; default https://euapi.ttlock.com
TTLOCK_BASE_URL=

# ---------------------------------------------------------------- Fiscal receipts (TRA VFD) â€” from your VFD provider
VFD_API_KEY=
# Your provider's host name(s), comma-separated, no https:// (the key is only ever sent to these)
VFD_ALLOWED_HOSTS=api.yourvfdprovider.co.tz

# ---------------------------------------------------------------- BMG subscriptions â€” ClickPesa, BMG's OWN account
# How hotels pay BMG their monthly subscription by phone. ClickPesa dashboard â†’ Developers / API keys.
# (Guests paying hotels by mobile money is switched off for now, so there is only this one ClickPesa account.)
CLICKPESA_CLIENT_ID_PLATFORM=IDeYebtCQTljz8Sc2Qqflzhuwfzekg7k
CLICKPESA_API_KEY_PLATFORM=SKjajN1dAhHIAj0h7IuYkPI890HiZWehONnBvanVZY
# Only if checksums are switched on in BMG's ClickPesa account
CLICKPESA_CHECKSUM_KEY_PLATFORM=
# Testing only: https://api-sandbox.clickpesa.com  (empty = live)
CLICKPESA_BASE_URL_PLATFORM=
# Random value; it ends the webhook address you set in BMG's ClickPesa account:
#   https://<project-ref>.supabase.co/functions/v1/clickpesa-webhook?token=<CLICKPESA_WEBHOOK_TOKEN>
CLICKPESA_WEBHOOK_TOKEN=1be4e1808ec7096bd427d1322b8ca430c5e21818296baec7f25b3b7462c7425f

# ---------------------------------------------------------------- QuickBooks Online â€” developer.intuit.com â†’ your app â†’ Keys and credentials
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Add exactly this as a Redirect URI in the Intuit app:  https://<project-ref>.supabase.co/functions/v1/quickbooks-oauth
QBO_REDIRECT_URI=
# sandbox while testing with a sandbox company, production when live
QBO_ENVIRONMENT=production

# ---------------------------------------------------------------- Hikvision cameras
# Nothing to set here. Each property's relay uses its own relay key (Integrations â†’ Hikvision â†’ Create relay key),
# and camera passwords stay on the relay PC in tools/hikvision-relay/relay.env.
# HIKVISION_RELAY_KEY= is the old shared key; leave it empty.

# ---------------------------------------------------------------- optional
# Tenda ICO tills calling from a browser (comma-separated origins). Tills on a server need nothing here.
POS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------- one property on its own account
# Add the property code (as set on Integrations â†’ that service) to the end of any name above, e.g.
#   CHANNEX_API_KEY_UH=...      TTLOCK_USERNAME_PBR=...
# That property uses its own value; every other property uses the plain one.
