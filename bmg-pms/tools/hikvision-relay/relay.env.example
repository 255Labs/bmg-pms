# =====================================================================
# BMG PMS — Hikvision relay settings for ONE property's on-site PC.
# Copy this file to relay.env in the same folder, fill it in, then run:  node relay.mjs
# relay.env holds a camera password: keep it on this PC only, never email it, never commit it.
# =====================================================================

# ---- where to send (from the PMS)
# Your Supabase project's ingest function. Replace <ref> with the project reference (Supabase → Project Settings → General).
PMS_URL=https://<ref>.supabase.co/functions/v1/hikvision-ingest
# This property's relay key: PMS → Integrations → Hikvision → Create relay key. Shown once; paste it here.
RELAY_KEY=

# ---- cameras to read (PULL mode, recommended)
# Comma-separated: a camera's own IP, or the NVR's IP with the camera's Virtual Host port (NVR → Network → Advanced → Virtual Host).
# Example from the first site: 192.168.88.153 served channels 5 (FRONT AREA) and 2.
PULL_HOSTS=192.168.88.153
# A camera user made only for the relay (System → User Management → Add, level Operator). Not admin.
HIK_USER=pms-relay
HIK_PASS=
# A different password for one device: HIK_PASS_ then the address with dots and colons as _
# HIK_PASS_192_168_88_111_65001=

# ---- what to keep
# 1 = only detections the camera classed as a person (AcuSense cameras). Events with no class are kept.
HUMAN_ONLY=1
# Seconds without a repeat that end one sighting (one person passing = one sighting).
GAP_SECONDS=10
# Clocks that send no time zone are taken as Dar es Salaam time.
TZ_OFFSET=+03:00

# ---- PUSH mode (only if the NVR forwards events: NVR → Network → Advanced → HTTP Listening → this PC, port 8090)
# PUSH=on
# PORT=8090
# Only these devices may push (the NVR's IP). Required when PUSH=on.
# ALLOWED_IPS=192.168.88.111

# ---- troubleshooting
# 1 = print every event the cameras send (turn off once it works)
DEBUG=0
# Where sightings wait while the internet is down
QUEUE_FILE=./relay-queue.json
